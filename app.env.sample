# app.env.sample
# Copy to app.env and adjust values before starting the stack.
# These variables override the matching values in default.env for this app.
# No `export` prefix - this file is read by `docker compose --env-file`.

TZ=America/New_York
BASE_DOMAIN_NAME=example.com
BASE_HOST_NAME=netbird.example.com

APP_ORG_NAME=NetBird
APP_RUN_AS=1000:1000

APP_SECRET_KEY=replace-with-a-random-16-byte-hex-string

NETBIRD_AUTH_AUDIENCE=netbird
NETBIRD_AUTH_CLIENT_ID=netbird-client
NETBIRD_AUTH_AUTHORITY=https://netbird.example.com
NETBIRD_AUTH_SUPPORTED_SCOPES=openid profile email offline_access api
